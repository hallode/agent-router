#!/usr/bin/env bash
# Claude-only router controls.
set -uo pipefail
ROUTER_HOME="${ROUTER_HOME:-$HOME/.claude/router}"
export ROUTER_CONFIG="${ROUTER_CONFIG:-$ROUTER_HOME/config.json}"
ROUTER_LOG="${ROUTER_LOG:-$ROUTER_HOME/decisions.jsonl}"
. "$ROUTER_HOME/lib/config.sh"
. "$ROUTER_HOME/lib/classify.sh"
. "$ROUTER_HOME/lib/governor.sh"
. "$ROUTER_HOME/lib/claude-model.sh"
. "$ROUTER_HOME/lib/workspace.sh"
. "$ROUTER_HOME/lib/controls.sh"
router_use_effective_config "$PWD"

case "${1:-status}" in
  status)
    router_status_header claude
    printf 'model map  '
    for tier in trivial execution reasoning; do printf '%s=%s ' "$tier" "$(governor_model "$tier")"; done
    printf '\n'
    ;;
  why)
    shift; tier=$(classify_tier '' "$*")
    printf 'host=claude tier=%s -> model=%s\n' "$tier" "$(governor_model "$tier")" ;;
  launch-model)
    [ "$(governor_state)" = NORMAL ] || governor_model execution ;;
  *)
    router_control "$@"; rc=$?
    [ "$rc" -ne 3 ] && exit "$rc"
    echo 'usage: router status|state|why|launch-model|probe|log|stats|enforce' >&2; exit 2 ;;
esac
