#!/usr/bin/env bash
# router — inspect and steer the agent router.
set -uo pipefail
ROUTER_HOME="${ROUTER_HOME:-$HOME/.claude/router}"
export ROUTER_CONFIG="${ROUTER_CONFIG:-$ROUTER_HOME/config.json}"
ROUTER_LOG="${ROUTER_LOG:-$ROUTER_HOME/decisions.jsonl}"
. "$ROUTER_HOME/lib/config.sh"
. "$ROUTER_HOME/lib/classify.sh"
. "$ROUTER_HOME/lib/governor.sh"
. "$ROUTER_HOME/lib/workspace.sh"

EFFECTIVE=$(router_effective_config "$PWD")
PROJECT_CFG=$(router_find_project_config "$PWD")
if router_is_temp_config "$EFFECTIVE"; then
  ROUTER_CONFIG="$EFFECTIVE"
  trap 'rm -f "$EFFECTIVE"' EXIT
fi

case "${1:-status}" in
  status)
    printf 'state      %s\n' "$(governor_state)"
    printf 'enforce    %s\n' "$(jq -r '.enforce' "$ROUTER_CONFIG")"
    [ -n "$PROJECT_CFG" ] && printf 'override   %s\n' "$PROJECT_CFG"
    ACCT=$(workspace_account "$PWD")
    if [ -n "$ACCT" ]; then
      printf 'account    %s (%s)\n' "$ACCT" "$PWD"
      MM=$(workspace_mismatch "$PWD"); [ -n "$MM" ] && printf 'warning    %s\n' "$MM"
    fi
    printf 'tier map   '
    for t in trivial execution reasoning; do printf '%s=%s ' "$t" "$(governor_model "$t")"; done
    printf '\n'
    if [ -s "$ROUTER_LOG" ]; then
      printf 'decisions  %s logged\n' "$(wc -l < "$ROUTER_LOG" | tr -d ' ')"
    else
      printf 'decisions  none yet\n'
    fi
    ;;
  state)
    case "${2:-}" in
      "") governor_state; echo ;;
      set) governor_set "${3:?state required}" "${4:-manual}" "${5:-0}"; echo ;;
      *) echo "usage: router state [set <NORMAL|CONSERVE|CRITICAL|DEPLETED> [reason] [ttl]]" >&2; exit 2 ;;
    esac
    ;;
  probe)
    Q=$(jq -r '.quota.command // ""' "$ROUTER_CONFIG" 2>/dev/null)
    if [ -z "$Q" ]; then echo "no quota command configured (see quota.command)"; exit 0; fi
    RAW=$(eval "$Q" 2>/dev/null)
    if governor_probe_quota >/dev/null 2>&1; then
      printf 'state      %s\n' "$(governor_state)"
      printf '%s' "$RAW" | jq -r '
        select(.used_percent != null)
        | "primary    \(.primary.used_percent)% of a \(.primary.window_minutes/60|floor)h window, resets \(.primary.resets_at | strflocaltime("%a %H:%M"))",
          "secondary  \(.secondary.used_percent)% of a \(.secondary.window_minutes/1440|floor)d window, resets \(.secondary.resets_at | strflocaltime("%a %H:%M"))"
      ' 2>/dev/null
    else
      echo "quota unavailable — governor stays on observed rate-limit errors"
    fi ;;
  why)     shift; printf 'tier=%s -> model=%s\n' "$(classify_tier "" "$*")" "$(governor_model "$(classify_tier "" "$*")")" ;;
  log)     tail -n "${2:-20}" "$ROUTER_LOG" 2>/dev/null | jq -r '[.ts,.action,.tier//"-",.model//"-",.description] | @tsv' 2>/dev/null ;;
  stats)
    [ -s "$ROUTER_LOG" ] || { echo "no decisions logged yet"; exit 0; }
    jq -rs 'group_by([.host, .model])
            | map({host:(.[0].host//"-"), model:(.[0].model//"-"), n:length})
            | sort_by(-.n) | .[] | "\(.n)\t\(.host)\t\(.model)"' "$ROUTER_LOG"
    printf -- '--\n'
    jq -rs 'group_by(.action) | map({a:.[0].action,n:length}) | sort_by(-.n) | .[] | "\(.n)\t\(.a)"' "$ROUTER_LOG"
    # A hand-forced tier is the strongest evidence the classifier was wrong.
    FORCED=$(jq -rs '[.[] | select(.tier_source == "forced")] | length' "$ROUTER_LOG" 2>/dev/null)
    BYPASS=$(jq -rs '[.[] | select(.action == "bypass")] | length' "$ROUTER_LOG" 2>/dev/null)
    if [ "${FORCED:-0}" -gt 0 ] 2>/dev/null || [ "${BYPASS:-0}" -gt 0 ] 2>/dev/null; then
      printf -- '--\n%s\tmanual overrides (forced tier)\n%s\tmanual bypasses (!!)\n' "${FORCED:-0}" "${BYPASS:-0}"
      printf 'Each one is a case the classifier got wrong. Worth reading:\n'
      jq -rs '[.[] | select(.tier_source == "forced" or .action == "bypass")][-5:][] | "  \(.tier)\t\(.description // "-")"' "$ROUTER_LOG" 2>/dev/null
    fi
    ;;
  enforce)
    v="${2:?true|false}"; tmp="$ROUTER_CONFIG.tmp.$$"
    jq --argjson v "$v" '.enforce=$v' "$ROUTER_CONFIG" > "$tmp" && mv "$tmp" "$ROUTER_CONFIG"
    printf 'enforce=%s\n' "$v" ;;
  launch-model)
    # A bare interactive launch carries no prompt to classify, so tier routing
    # cannot apply. What still applies is the budget: when quota is tight there
    # is a reason to start cheaper. When it is not, stay out of the way and let
    # the host use its own default — silence here means "no override".
    ST=$(governor_state)
    [ "$ST" = NORMAL ] && exit 0
    case "${2:-claude}" in
      claude) governor_model execution ;;
      codex)
        case "$ST" in CONSERVE) I=0 ;; CRITICAL) I=1 ;; *) I=2 ;; esac
        N=$(jq -r '.codex_chains.execution | length' "$ROUTER_CONFIG" 2>/dev/null)
        [ -z "$N" ] || [ "$N" = null ] && exit 0
        [ "$I" -ge "$N" ] && I=$((N - 1))
        jq -r --argjson i "$I" '.codex_chains.execution[$i] | "\(.model)\t\(.effort)"' "$ROUTER_CONFIG" 2>/dev/null
        ;;
    esac ;;
  test)    bash "$ROUTER_HOME/tests/run.sh" ;;
  *)
    cat <<'USAGE'
router — agent model router

  router status              current state, workspace, tier map
  router why <text>          explain how a prompt would be classified
  router state [set S [r] [ttl]]
  router probe               refresh state from the configured quota command
  router log [n]             recent routing decisions
  router stats               decision counts by model and action
  router enforce true|false  hard-route vs dry-run
  router test                run the test suite

A repository can override routing with .agent-router.json at its root; the
nearest one above the working directory is merged over the global config.
USAGE
    ;;
esac
